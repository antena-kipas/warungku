# =============================================================================
# CONTOH PENGATURAN WARUNGKU
#
# Cara pakai:
#   1. Salin file ini menjadi ".env" (di folder yang sama)
#        Windows (PowerShell):  Copy-Item .env.example .env
#   2. Ganti semua nilai di bawah dengan milikmu sendiri.
#   3. File .env berisi rahasia: JANGAN di-commit ke git (sudah dicegah oleh .gitignore)
#      dan jangan dikirim ke grup chat.
#
# Langkah lengkap (pasang PostgreSQL, buat database, dll.) ada di README.md.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. KUNCI RAHASIA APLIKASI (wajib)
# Dipakai untuk mengamankan sesi login. Isi dengan teks acak yang panjang.
# Buat dengan perintah:
#   python -c "import secrets; print(secrets.token_hex(24))"
# -----------------------------------------------------------------------------
SECRET_KEY=ganti_dengan_hasil_perintah_di_atas


# -----------------------------------------------------------------------------
# 2. DATABASE POSTGRESQL (wajib)
# Format:
#   postgresql://USER_DATABASE:PASSWORD_DATABASE@HOST:PORT/NAMA_DATABASE
#
# USER_DATABASE, PASSWORD_DATABASE, dan NAMA_DATABASE adalah yang kamu buat
# sendiri di PostgreSQL (lihat README.md bagian "Membuat database").
# HOST "localhost" dan PORT 5432 adalah bawaan PostgreSQL di laptop sendiri.
#
# Catatan: kalau password database mengandung simbol seperti @ : / # ?,
# lebih mudah pakai password yang hanya berisi huruf dan angka.
#
# Ini adalah database PostgreSQL di komputer kasir sendiri (bukan database
# server AI). Aplikasi tidak mau jalan kalau baris ini kosong.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://warungku:password_database_kamu@localhost:5432/warungku


# -----------------------------------------------------------------------------
# 3. AKUN LOGIN PERTAMA (wajib saat menjalankan "python init_db.py")
# Akun ini yang dipakai untuk masuk ke aplikasi kasir.
# Password minimal 8 karakter. Jangan sama dengan password database.
# Kalau akunnya sudah pernah dibuat, init_db.py tidak mengubahnya lagi.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_login_kamu
