# .env.example
# This file contains example environment variables.
# Copy this file to .env and fill in your actual secret keys and configuration.

SECRET_KEY=your_super_secret_key_here
# Example: SECRET_KEY=a_long_random_string_of_characters
# You can generate a good secret key using:
# python -c 'import os; print(os.urandom(24).hex())'

# Alamat database PostgreSQL (Supabase, Neon, Railway, dll).
# Kosongkan / hapus baris ini untuk memakai SQLite lokal (file kasir.db) saat coba-coba di laptop.
# DATABASE_URL=postgresql://nama_user:password@alamat-host:5432/nama_database

# Akun login pertama yang dibuat oleh "python init_db.py".
# WAJIB diganti sebelum aplikasi dipakai online.
ADMIN_USERNAME=warungku
ADMIN_PASSWORD=ganti_password_ini
